generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  OPERATOR
}

enum ListingStatus {
  DRAFT
  LISTED
  RESERVED
  SOLD
  DELISTED
}

enum EscrowStatus {
  CREATED
  FUNDED
  SHIPPED
  DISPUTED
  RELEASED
  REFUNDED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  role          Role     @default(BUYER)
  createdAt     DateTime @default(now())
  listings      Listing[]
  purchases     Escrow[] @relation("buyer")
  sales         Escrow[] @relation("seller")
}

model Listing {
  id        String        @id @default(uuid())
  sellerId  String
  seller    User          @relation(fields: [sellerId], references: [id])
  title     String
  make      String
  model     String
  year      Int
  vin       String
  mileage   Int
  priceUsdc Decimal       @db.Decimal(20, 6)
  status    ListingStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  images    ListingImage[]
  escrows   Escrow[]
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  s3Key     String
  position  Int
}

model Escrow {
  id              String       @id @default(uuid())
  listingId       String
  listing         Listing      @relation(fields: [listingId], references: [id])
  buyerId         String
  buyer           User         @relation("buyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User         @relation("seller", fields: [sellerId], references: [id])
  chainId         Int
  contractAddress String
  onchainId       String
  amountUsdc      Decimal      @db.Decimal(20, 6)
  status          EscrowStatus @default(CREATED)
  shippedAt       DateTime?
  disputedAt      DateTime?
  simulated       Boolean      @default(true)
  fundTx          String?
  releaseTx       String?
  refundTx        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ChainEvent {
  id          BigInt   @id @default(autoincrement())
  txHash      String
  logIndex    Int
  blockNumber BigInt
  eventName   String
  payload     Json
  processedAt DateTime?

  @@unique([txHash, logIndex])
}

model SiweNonce {
  id        String    @id @default(uuid())
  nonce     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
